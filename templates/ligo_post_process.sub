universe                 = vanilla
getenv                   = False

executable               = /bin/bash
transfer_executable      = False
arguments                = "-e $(macroargument0)"

should_transfer_files    = YES
when_to_transfer_output  = ON_EXIT
transfer_input_files     = $(macroargument1), $(macroargument2)
transfer_output_files    = $(macroargument3)
transfer_output_remaps   = "$(macroargument4)"

accounting_group         = @CONDOR_ACCOUNTING_GROUP@
accounting_group_user    = @CONDOR_ACCOUNTING_GROUP_USER@
+OmicronPostProcess      = "@POST_PROCESS_GROUP@"

environment              = "PATH=/cvmfs/software.igwn.org/conda/envs/igwn-py311/bin:/usr/bin:/bin;HDF5_USE_FILE_LOCKING=FALSE"

error                    = @LOG_DIR@/post-processing-$(cluster)-$(process).err
output                   = @LOG_DIR@/post-processing-$(cluster)-$(process).out
log                      = @LOG_DIR@/post-processing-$(cluster)-$(process).log
stream_output             = True
stream_error              = True

request_cpus              = 2
request_memory            = 4GB
request_disk              = 4GB

queue 1
